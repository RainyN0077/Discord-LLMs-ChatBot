DRIVER=~httpx+~websockets
# DISCORD_BOTS: JSON array of bot configs.
# intent keys: guilds, guild_messages, direct_messages, message_content, members
# members (= GUILD_MEMBERS) is REQUIRED for member search & blacklist. Must also be enabled in Developer Portal → Bot → Privileged Gateway Intents.
DISCORD_BOTS=[{"token": "", "intent": {"guilds": true, "guild_messages": true, "direct_messages": true, "message_content": true, "members": true}}]
DISCORD_HANDLE_SELF_MESSAGE=false
ONEBOT_BOTS=[]
